# Copy this file to .env and fill in your values
# NEVER commit .env to git

# Gemini API key (used for AI poster/slogan generation)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Google Custom Search JSON API — enables REAL Google Images search results
# in the admin image studio (each tourist place loads its real photograph from Google Images).
# 1) Create a Custom Search Engine at https://programmablesearchengine.google.com/ (turn ON Image search)
# 2) Copy the Search engine ID (cx) from the CSE console.
# 3) Enable the "Custom Search API" and create an API key at https://console.cloud.google.com/apis/
# If left empty, the studio falls back to real photos from Wikipedia / Wikimedia Commons.
VITE_GOOGLE_CSE_KEY=your_google_custom_search_api_key_here
VITE_GOOGLE_CSE_CX=your_custom_search_engine_id_here
